<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mdyaipay</groupId>
        <artifactId>mdyaipay-tools-loadtest</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mdyaipay-tools-loadtest-cli</artifactId>
    <name>mdyaipay-tools-loadtest-cli</name>
    <description>压测命令行入口：加载 YAML/JSON 场景并输出报告</description>

    <dependencies>
        <dependency>
            <groupId>com.mdyaipay</groupId>
            <artifactId>mdyaipay-tools-loadtest-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mdyaipay</groupId>
            <artifactId>mdyaipay-tools-loadtest-http</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mdyaipay</groupId>
            <artifactId>mdyaipay-tools-loadtest-dubbo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mdyaipay</groupId>
            <artifactId>mdyaipay-tools-loadtest-springcloud</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.mdyaipay.tools.loadtest.cli.LoadTestCliMain</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
