<?xml version="1.0" encoding="UTF-8"?>
<!-- 七个运行服务共用：stdout 与滚动文件均为 ECS JSON，供 Filebeat / 本地检索 -->
<Configuration status="WARN" monitorInterval="30">
    <Properties>
        <Property name="APP_LOG">${spring:logging.file.name:-logs/mdyaipay.log}</Property>
        <Property name="SERVICE_NAME">${spring:spring.application.name:-mdyaipay}</Property>
        <Property name="TIMETRACE_LOG">${spring:mdyaipay.timetrace.log-file:-logs/timetrace.log}</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <EcsLayout serviceName="${SERVICE_NAME}"
                       includeMarkers="true"
                       stackTraceAsArray="false">
                <AdditionalField key="trace.id" value="${ctx:traceId}"/>
                <AdditionalField key="span.id" value="${ctx:spanId}"/>
            </EcsLayout>
        </Console>
        <RollingFile name="AppFile"
                     fileName="${APP_LOG}"
                     filePattern="${APP_LOG}.%d{yyyy-MM-dd}.gz">
            <EcsLayout serviceName="${SERVICE_NAME}"
                       includeMarkers="true"
                       stackTraceAsArray="false">
                <AdditionalField key="trace.id" value="${ctx:traceId}"/>
                <AdditionalField key="span.id" value="${ctx:spanId}"/>
            </EcsLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>
        <RollingFile name="TimeTraceFile"
                     fileName="${TIMETRACE_LOG}"
                     filePattern="${TIMETRACE_LOG}.%d{yyyy-MM-dd}.gz"
                     immediateFlush="true">
            <PatternLayout pattern="%msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="com.mdyaipay.tools.timetrace.report"
                level="info"
                additivity="false">
            <AppenderRef ref="TimeTraceFile"/>
        </Logger>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
        </Root>
    </Loggers>
</Configuration>
