# 复制为 Secret mdyaipay-kibana-secrets（不要提交真实值）
# kubectl -n mdyaipay-infra create secret generic mdyaipay-kibana-secrets \
#   --from-literal=ENCRYPTION_KEY="$(openssl rand -hex 32)" \
#   --from-literal=WEBHOOK_URL=""
apiVersion: v1
kind: Secret
metadata:
  name: mdyaipay-kibana-secrets
type: Opaque
stringData:
  ENCRYPTION_KEY: "replace-with-32-plus-character-key"
  WEBHOOK_URL: ""
